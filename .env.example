NODE_ENV=development

# PostgreSQL + pgvector
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://knowflow:knowflow_password@localhost:5432/knowflow

# Redis + BullMQ
# 注意(Windows):若 docker 启动报 "bind: ...forbidden" 或 worker 连不上 Redis,
# 多半是 6379 落入 Windows 保留端口段(netsh int ipv4 show excludedportrange protocol=tcp 查看)。
# 解决:把下面三项的 6379 改成范围外端口(如 16379),docker-compose 端口映射由 REDIS_PORT 驱动。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Local services
API_HOST=0.0.0.0
API_PORT=4000
# 查询理解：rules 为硬规则+LLM，llm_only 跳过规则，legacy 可回滚修改前链路。
QUERY_ROUTING_MODE=rules
API_PUBLIC_URL=http://localhost:4000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Seed bootstrap account
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=ChangeMe_123456
SEED_ADMIN_NAME=System Administrator

# Session secret. Replace in real deployments.
SESSION_SECRET=replace-with-a-long-random-session-secret

# 阿里云百炼凭据由 API 和 Worker 在调用模型时直接从环境变量读取。
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_API_KEY=

# Local file storage for uploaded documents and conversation attachments.
LOCAL_STORAGE_ROOT=./storage

# Docling 薄适配服务（启动方式见 services/docling/README.md）。
DOCLING_URL=http://127.0.0.1:5001
DOCLING_API_KEY=
# MD 外链图片仅允许指定的 HTTPS 来源，逗号分隔；本地相对路径需要配套附件。
DOCLING_MD_IMAGE_ORIGINS=
